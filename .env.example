# Outreach Suite — Example Environment Variables
# Copy this file to .env.local and fill in your values

# === Supabase Configuration ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Google OAuth (for Gmail reply polling) ===
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === Cloudinary (for video/GIF hosting) ===
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# === App Configuration ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
DASHBOARD_PASSWORD=capital123
OS_PASSWORD=capital123

# === Cron Security ===
# Used to authenticate cron triggers (can be any random string)
CRON_SECRET=change-this-to-a-random-secret

# === Cloud Lip-Sync (V2 video generation) ===
# Primary provider: Modal MuseTalk — ~$0.001/video with $30/mo free credits
# Set after running: modal deploy modal_musetalk.py
MODAL_ENDPOINT_URL=https://youruser--musetalk-v2-musetalkinference-generate.modal.run
#
# Fallback: Replicate MuseTalk — $0.19/video
# Get key at: https://replicate.com/account/api-tokens
REPLICATE_API_KEY=your-replicate-api-key
#
# Last resort: sync.so — commercial quality, ~$2.40/60s-video
# Get key at: https://sync.so
SYNC_API_KEY=your-sync-api-key

# Seed video URL used for V2 lip-sync generation (Cloudinary video URL)
# Default: https://res.cloudinary.com/<cloud>/video/upload/v2_seed/template
# SEED_VIDEO_URL=

# === VoiceKit (personalized video generation) ===
VK_API_URL=http://localhost:5000
# VK_ROOT — VoiceKit project root (default: ../voicekit)
# VK_DEFAULT_VOICE_SAMPLE — Fallback voice sample when a lead has none
# VK_TEMPLATE_VIDEO — Default template video path
# NEXT_PUBLIC_VK_API_URL — Public URL for VoiceKit API (default: http://localhost:5000)

# === SMTP from_name Fallback ===
# No env variable needed — configured per inbox in the UI
