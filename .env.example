# Outreach Suite — Example Environment Variables
# Copy this file to .env.local and fill in your values

# === Supabase Configuration ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Google OAuth (for Gmail reply polling) ===
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === Cloudinary (for video/GIF hosting) ===
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# === App Configuration ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
DASHBOARD_PASSWORD=capital123
OS_PASSWORD=capital123

# === Cron Security ===
# Used to authenticate cron triggers (can be any random string)
CRON_SECRET=change-this-to-a-random-secret

# === SMTP from_name Fallback ===
# No env variable needed — configured per inbox in the UI
